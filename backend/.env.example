# 复制为 .env 后填写。不填 KEY 也能跑，会自动进入"真实运行记录回放"模式。
# 华为云控制台 → ModelArts Studio → 在线推理 → API Key 管理 → 创建
MAAS_API_KEY=

# OpenAI 兼容端点（一般不用改）
MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1

# 模型白名单在 providers.py 里硬编码，仅允许：deepseek-v4.1-flash-1017
MAAS_MODEL=deepseek-v4.1-flash-1017

# auto = 有 Key 走真实调用，无 Key 回放；maas = 强制真实；replay = 强制回放
MODE=auto

# 单次评审超时（秒）
REVIEW_TIMEOUT=60
